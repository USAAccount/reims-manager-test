<Window x:Class="ReimsManager.NewVmWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager" Title="{local:Loc &apos;macOS をセットアップ&apos;}" Width="760" Height="760" MinWidth="650" MinHeight="650"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable, Yu Gothic UI" FontSize="14">
 <Grid Background="{DynamicResource ApplicationBackgroundBrush}"><Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock x:Name="StepTitle" Text="{local:Loc &apos;2 / 3  Windows の準備&apos;}" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock x:Name="StepHint" Text="{local:Loc &apos;必須の項目を確認します。USB・ブリッジ接続の準備は後からでも行えます。&apos;}" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.75"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <DockPanel x:Name="RequirementsPage">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
     <TextBlock x:Name="RequirementsSummary" Text="{local:Loc &apos;必要な機能を確認しています…&apos;}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <WrapPanel Margin="0,12,0,0">
      <Button x:Name="RefreshRequirementsButton" Content="{local:Loc &apos;再確認&apos;}" Click="RefreshRequirementsClick" Margin="0,0,8,8"/>
      <Button x:Name="EnableWhpxButton" Content="{local:Loc &apos;WHPX を有効にする（管理者）&apos;}" Tag="EnableWhpx" Click="RepairRequirement" Visibility="Collapsed" Margin="0,0,8,8"/>
      <Button x:Name="InstallUsbButton" Content="{local:Loc &apos;USB ドライバーを導入（任意）&apos;}" Tag="InstallUsbDk" Click="RepairRequirement" Visibility="Collapsed" Margin="0,0,8,8"/>
     </WrapPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="RequirementsList"><ItemsControl.ItemTemplate><DataTemplate>
     <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Message}" Margin="0,5,0,0" TextWrapping="Wrap" Opacity="0.75"/></StackPanel>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </DockPanel>
   <ScrollViewer x:Name="VmPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="{local:Loc &apos;macOS インストーラー (ISO / IMG)&apos;}" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <DockPanel><Button Content="{local:Loc &apos;参照…&apos;}" Click="BrowseInstaller" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Installer" AutomationProperties.Name="{local:Loc &apos;インストーラー&apos;}"/></DockPanel>
     <TextBlock Text="{local:Loc &apos;仮想マシンの名前&apos;}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VmName" Text="macOS Tahoe" TextChanged="VmLocationChanged" AutomationProperties.Name="{local:Loc &apos;仮想マシンの名前&apos;}"/>
     <TextBlock Text="{local:Loc &apos;保存先の親フォルダー&apos;}" Style="{StaticResource FieldLabel}"/>
     <DockPanel><Button Content="{local:Loc &apos;参照…&apos;}" Click="BrowseFolder" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="ParentFolder" TextChanged="VmLocationChanged" AutomationProperties.Name="{local:Loc &apos;VM の親フォルダー&apos;}"/></DockPanel>
     <TextBlock x:Name="LocationPreview" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"/>
     <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{local:Loc &apos;ディスク (GiB)&apos;}" Margin="0,0,0,8"/><TextBox x:Name="Capacity" Text="300" AutomationProperties.Name="{local:Loc &apos;仮想ディスク容量 GiB&apos;}"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="CPU (vCPU)" Margin="0,0,0,8"/><TextBox x:Name="CpuCount" Text="4" AutomationProperties.Name="{local:Loc &apos;CPU 数&apos;}"/></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="{local:Loc &apos;メモリ (MiB)&apos;}" Margin="0,0,0,8"/><TextBox x:Name="MemorySize" Text="4096" AutomationProperties.Name="{local:Loc &apos;メモリ MiB&apos;}"/></StackPanel>
     </Grid>
     <Button Content="{local:Loc &apos;割り当てを再確認&apos;}" Click="RefreshRequirementsClick" HorizontalAlignment="Left" Margin="0,12,0,0"/>
     <TextBlock Text="{local:Loc &apos;仮想ディスクは使用量に応じて増えます。選んだフォルダーの中に VM ごとのフォルダーを作成します。&apos;}" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.75"/>
     <TextBlock x:Name="MemoryPlan" TextWrapping="Wrap" Margin="0,20,0,8" AutomationProperties.LiveSetting="Polite"/>
     <CheckBox x:Name="StartAfterCreation" Content="{local:Loc &apos;準備ができたらインストーラーを起動する&apos;}" IsChecked="True" Margin="0,8,0,0"/>
     <TextBlock Text="{local:Loc &apos;QEMU・OpenCore・OVMF・GPU ROM・ゲスト用アドオンを自動で準備します。macOS のインストールと初回設定は VM の画面で行ってください。&apos;}" TextWrapping="Wrap" Margin="0,16,0,0" Opacity="0.75"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,16,0,0"><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed"/><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Notice" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/></ScrollViewer></StackPanel>
  <Grid Grid.Row="3" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="BackButton" Content="{local:Loc &apos;必要条件に戻る&apos;}" Click="Back" HorizontalAlignment="Left" Visibility="Collapsed"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Content="{local:Loc &apos;キャンセル&apos;}" Click="Cancel" Margin="0,0,8,0"/>
    <Button x:Name="NextButton" Content="{local:Loc &apos;インストーラーを選ぶ&apos;}" Click="Next" IsEnabled="False" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0"/>
    <Button x:Name="CreateButton" Content="{local:Loc &apos;仮想マシンを作成&apos;}" Click="Create" Visibility="Collapsed" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0"/>
   </StackPanel>
  </Grid>
 </Grid></Grid>
</Window>
