<Window x:Class="ReimsManager.EngineSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager" Title="{local:Loc &apos;Reims エンジンをセットアップ&apos;}"
 Width="700" Height="680" MinWidth="620" MinHeight="640" WindowStartupLocation="CenterOwner"
 FontFamily="Segoe UI Variable, Yu Gothic UI" FontSize="14">
 <Grid Background="{DynamicResource ApplicationBackgroundBrush}"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{local:Loc &apos;VM を動かす準備&apos;}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <TextBlock Text="{local:Loc &apos;Reims 対応 QEMU、必要な DLL、OpenCore、OVMF、GPU ROM、ISO ツールをまとめて導入します。&apos;}" TextWrapping="Wrap"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,24,0,16" x:Name="Inputs">
   <TextBlock Text="{local:Loc &apos;エンジンの保存先&apos;}" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <DockPanel><Button Content="{local:Loc &apos;参照…&apos;}" Click="BrowseDestination" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Destination" AutomationProperties.Name="{local:Loc &apos;エンジンの保存先&apos;}"/></DockPanel>
   <TextBlock Text="{local:Loc &apos;新規導入では未使用のフォルダー、再利用では導入済みエンジンのフォルダーを指定します。VM は別の保存先に作成します。&apos;}" TextWrapping="Wrap" Margin="0,8,0,16" Opacity="0.7"/>
   <RadioButton x:Name="Existing" Content="{local:Loc &apos;導入済みのエンジンを検証して再利用&apos;}" Margin="0,0,0,10"/>
   <RadioButton x:Name="Online" Content="{local:Loc &apos;対応するリリースをダウンロード&apos;}" IsChecked="True" Margin="0,0,0,10"/>
   <RadioButton x:Name="Local" Content="{local:Loc &apos;ダウンロード済みのエンジン ZIP を使用&apos;}" Margin="0,0,0,8"/>
   <DockPanel Margin="24,0,0,0"><Button Content="{local:Loc &apos;ZIP を選択…&apos;}" Click="BrowseArchive" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Archive" IsReadOnly="True" AutomationProperties.Name="{local:Loc &apos;エンジン ZIP&apos;}"/></DockPanel>
   <TextBlock Text="{local:Loc &apos;配布元の ZIP と .zip.sha256 を同じ場所に保存してください。照合は自動で行います。&apos;}" TextWrapping="Wrap" Margin="24,8,0,0" Opacity="0.7"/>
  </StackPanel>
  <Border Grid.Row="2" BorderThickness="1" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="Status" Text="{local:Loc &apos;保存先を選んでセットアップを開始します。&apos;}" TextWrapping="Wrap"/>
    <ProgressBar x:Name="Progress" Grid.Row="1" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,12,0,12"/>
    <TextBox x:Name="Details" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="0,8,0,0" AutomationProperties.Name="{local:Loc &apos;セットアップの詳細&apos;}"/>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button x:Name="CloseButton" Content="{local:Loc &apos;閉じる&apos;}" Click="CloseWindow" Margin="0,0,8,0" Padding="18,8"/>
   <Button x:Name="InstallButton" Content="{local:Loc &apos;セットアップ&apos;}" Click="Install" Padding="18,8" IsDefault="True"/>
  </StackPanel>
 </Grid></Grid>
</Window>
