<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="ReimsManager.MainWindow" Title="Reims Manager" Width="1380" Height="880" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable, Yu Gothic UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="WindowKeyDown" StateChanged="WindowStateChanged" WindowStyle="SingleBorderWindow">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- These styles are local to the workstation; setup dialogs keep their native Fluent styles. -->
    <Style x:Key="CommandButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CommandIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="DeviceIcon" TargetType="TextBlock" BasedOn="{StaticResource CommandIcon}">
      <Setter Property="Width" Value="28"/>
    </Style>
    <Style x:Key="WorkspaceTab" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="TabSurface" Background="Transparent" CornerRadius="6,6,0,0" BorderBrush="Transparent" BorderThickness="1"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Border x:Name="TabIndicator" Height="3" Margin="14,0" VerticalAlignment="Bottom" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" CornerRadius="2" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource ItemHoverBackground}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource CardBackground}"/>
                <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DeviceItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItem}">
      <Setter Property="Padding" Value="10,10"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style x:Key="WorkspaceNotice" TargetType="Border" BasedOn="{StaticResource NoticeCard}">
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>
  <Border x:Name="ChromeRoot" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
    <Grid x:Name="AppLayout" Background="{DynamicResource ApplicationBackgroundBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border x:Name="TitleBar" Grid.Row="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="SessionCommands" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
            <Button x:Name="LibraryCommand" Content="" Click="ShowLibrary" Style="{StaticResource ChromeButton}" ToolTip="{local:Loc &apos;ライブラリに戻る（VMは実行を続けます）&apos;}" AutomationProperties.Name="{local:Loc &apos;ライブラリに戻る&apos;}"/>
            <Button x:Name="SessionPowerButton" Content="" Click="ShowPowerMenu" Style="{StaticResource ChromeButton}" ToolTip="{local:Loc &apos;VMの電源操作&apos;}" AutomationProperties.Name="{local:Loc &apos;VMの電源操作&apos;}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{local:Loc &apos;シャットダウン&apos;}" Tag="PowerOff" Click="MenuAction"/>
                  <MenuItem Header="{local:Loc &apos;完全終了&apos;}" Tag="Exit" Click="MenuAction"/>
                  <Separator/>
                  <MenuItem Header="{local:Loc &apos;強制終了…&apos;}" Tag="ForceExit" Click="ForceExit"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button x:Name="SessionPauseButton" Content="" Tag="Pause" Click="ActionClick" Style="{StaticResource ChromeButton}" ToolTip="{local:Loc &apos;一時停止&apos;}" AutomationProperties.Name="{local:Loc &apos;一時停止&apos;}"/>
            <Button x:Name="SessionRestartButton" Content="" Tag="Restart" Click="ActionClick" Style="{StaticResource ChromeButton}" ToolTip="{local:Loc &apos;macOSを再起動&apos;}" AutomationProperties.Name="{local:Loc &apos;macOSを再起動&apos;}"/>
            <Border Width="1" Margin="6,9" Background="{DynamicResource CardBorderBrush}"/>
            <Button x:Name="SessionSettingsButton" Content="" Click="OpenSettings" Style="{StaticResource ChromeButton}" ToolTip="{local:Loc &apos;仮想マシンの設定&apos;}" AutomationProperties.Name="{local:Loc &apos;仮想マシンの設定&apos;}"/>
            <Button x:Name="SessionCursorAidButton" Content="{local:Loc &apos;カーソルを表示&apos;}" Tag="EnableCursorAid" Click="ActionClick" Style="{StaticResource CommandButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{local:Loc &apos;1 回のクリックで、SSH ペアリング済みの VM に同梱ヘルパーを検証・導入して起動します。解除は「設定 → ディスプレイ → カーソル互換表示 → オフにする」。&apos;}" AutomationProperties.Name="{local:Loc &apos;カーソルを表示&apos;}"/>
            <Button x:Name="SessionCursorMenuButton" Content="" Click="ShowPowerMenu" Style="{StaticResource ChromeButton}" Width="26" ToolTip="{local:Loc &apos;カーソルの移動と設定&apos;}" AutomationProperties.Name="{local:Loc &apos;カーソルの移動と設定&apos;}">
              <Button.ContextMenu><ContextMenu>
                <MenuItem Header="{local:Loc &apos;VM 本体の画面へ移動&apos;}" Tag="MoveCursorToMainDisplay" Click="MenuAction"/>
                <MenuItem Header="{local:Loc &apos;拡張画面へ移動&apos;}" Tag="MoveCursorToExtendedDisplay" Click="MenuAction"/>
                <Separator/>
                <MenuItem Header="{local:Loc &apos;Windows 側のカーソルを隠す&apos;}" Tag="HideHostCursor" Click="MenuAction"/>
                <MenuItem Header="{local:Loc &apos;Windows 側のカーソルを表示&apos;}" Tag="ShowHostCursor" Click="MenuAction"/>
                <Separator/>
                <MenuItem Header="{local:Loc &apos;カーソル互換表示をオフ&apos;}" Tag="DisableCursorAid" Click="MenuAction"/>
                <MenuItem Header="{local:Loc &apos;Windows に戻す: Ctrl + Alt + Home（対応エンジン）&apos;}" IsEnabled="False"/>
              </ContextMenu></Button.ContextMenu>
            </Button>
            <Button x:Name="SessionUsbButton" Content="" Tag="usb" Click="OpenSettingsCategory" Style="{StaticResource ChromeButton}" ToolTip="{local:Loc &apos;USBデバイス&apos;}" AutomationProperties.Name="{local:Loc &apos;USBデバイス&apos;}"/>
            <Button x:Name="SessionSharingButton" Content="" Tag="2" Click="NavigatePage" Style="{StaticResource ChromeButton}" ToolTip="{local:Loc &apos;クリップボード共有&apos;}" AutomationProperties.Name="{local:Loc &apos;クリップボード共有&apos;}"/>
            <Button x:Name="SessionSnapshotButton" Content="" Tag="4" Click="NavigatePage" Style="{StaticResource ChromeButton}" ToolTip="{local:Loc &apos;スナップショット&apos;}" AutomationProperties.Name="{local:Loc &apos;スナップショット&apos;}"/>
            <Button x:Name="SessionPopOutButton" Content="" Click="PopOutConsole" Style="{StaticResource ChromeButton}" ToolTip="{local:Loc &apos;VM画面を別ウィンドウで開く&apos;}" AutomationProperties.Name="{local:Loc &apos;VM画面を別ウィンドウで開く&apos;}"/>
            <Button x:Name="SessionFullScreenButton" Content="" Click="ToggleFullScreen" Style="{StaticResource ChromeButton}" ToolTip="{local:Loc &apos;全画面表示 (F11)&apos;}" AutomationProperties.Name="{local:Loc &apos;全画面表示&apos;}"/>
          </StackPanel>
          <StackPanel x:Name="ApplicationBrand" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,10,0"/>
            <TextBlock Text="Reims Manager" FontWeight="SemiBold" TextWrapping="NoWrap"/>
          </StackPanel>
          <TextBlock x:Name="SessionTitle" Grid.Column="1" Text="{Binding Text, ElementName=VmTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="12,0" FontSize="12" ToolTip="{local:Loc &apos;入力を Windows に戻す: Ctrl + Alt + Home / Ctrl + Alt + Win（Home は対応エンジンが必要です）&apos;}"/>
          <StackPanel x:Name="CaptionCommands" Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="MinimizeCommand" Content="" Click="MinimizeWindow" Style="{StaticResource CaptionButton}" ToolTip="{local:Loc &apos;最小化&apos;}" AutomationProperties.Name="{local:Loc &apos;最小化&apos;}"/>
            <Button x:Name="MaximizeCommand" Content="" Click="MaximizeWindow" Style="{StaticResource CaptionButton}" ToolTip="{local:Loc &apos;最大化 / 元に戻す&apos;}" AutomationProperties.Name="{local:Loc &apos;最大化または元に戻す&apos;}"/>
            <Button x:Name="CloseCommand" Content="" Click="CloseWindow" Style="{StaticResource CaptionButton}" ToolTip="{local:Loc &apos;ウィンドウを閉じる（VMは終了しません）&apos;}" AutomationProperties.Name="{local:Loc &apos;ウィンドウを閉じる&apos;}"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel x:Name="GlobalNotices" Grid.Row="1" Margin="12,0">
        <TextBlock x:Name="StatusDetail" Margin="4,0,4,10" MaxHeight="54" TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <StackPanel x:Name="OperationProgress" Visibility="Collapsed" Margin="4,0,4,10">
          <TextBlock x:Name="OperationStatus" Text="{local:Loc &apos;処理しています…&apos;}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
          <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True"/>
        </StackPanel>
        <Border x:Name="EngineNotice" Style="{StaticResource WorkspaceNotice}">
          <DockPanel>
            <Button Content="{local:Loc &apos;セットアップ…&apos;}" Click="SetupEngine" DockPanel.Dock="Right" Margin="16,0,0,0"/>
            <StackPanel>
              <TextBlock Text="{local:Loc &apos;Reims エンジンを設定&apos;}" FontWeight="SemiBold"/>
              <TextBlock Text="{local:Loc &apos;最初に一度だけ必要です。設定後に VM を作成・起動できます。&apos;}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border x:Name="Feedback" Visibility="Collapsed" Style="{StaticResource WorkspaceNotice}">
          <DockPanel>
            <Button Content="{local:Loc &apos;閉じる&apos;}" Click="DismissError" DockPanel.Dock="Right" Margin="16,0,0,0"/>
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="ErrorNotice" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </StackPanel>
      <StackPanel x:Name="ManagementCommands" Grid.Row="2">
        <Menu Padding="12,2" Background="Transparent">
          <MenuItem Header="{local:Loc &apos;ファイル&apos;}">
            <MenuItem Header="{local:Loc &apos;新しい仮想マシン…&apos;}" InputGestureText="Ctrl+N" Click="NewVm"/>
            <MenuItem Header="{local:Loc &apos;仮想マシンを開く…&apos;}" InputGestureText="Ctrl+O" Click="OpenVm"/>
            <MenuItem Header="{local:Loc &apos;既存のディスクを取り込む…&apos;}" Click="ImportVm"/>
            <Separator/>
            <MenuItem Header="{local:Loc &apos;VM の保存先を開く&apos;}" Click="RevealVm"/>
          </MenuItem>
          <MenuItem Header="{local:Loc &apos;仮想マシン&apos;}">
            <MenuItem x:Name="MenuStart" Header="{local:Loc &apos;起動&apos;}" Tag="Start" Click="MenuAction"/>
            <MenuItem x:Name="MenuPowerOff" Header="{local:Loc &apos;シャットダウン&apos;}" Tag="PowerOff" Click="MenuAction"/>
            <MenuItem x:Name="MenuRestart" Header="{local:Loc &apos;再起動&apos;}" Tag="Restart" Click="MenuAction"/>
            <Separator/>
            <MenuItem x:Name="MenuForceExit" Header="{local:Loc &apos;強制終了…&apos;}" Click="ForceExit"/>
          </MenuItem>
          <MenuItem Header="{local:Loc &apos;表示&apos;}">
            <MenuItem x:Name="FullScreenMenuItem" Header="{local:Loc &apos;全画面表示&apos;}" InputGestureText="F11" Click="ToggleFullScreen"/>
            <MenuItem Header="{local:Loc &apos;状態を更新&apos;}" InputGestureText="F5" Click="RefreshClick"/>
            <MenuItem Header="{local:Loc &apos;VM 画面を別ウィンドウにする&apos;}" Click="PopOutConsole"/>
            <MenuItem Header="{local:Loc &apos;VM 画面をアプリに戻す&apos;}" Click="DockConsole"/>
          </MenuItem>
        </Menu>
        <Border x:Name="CommandBar" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,5,12,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="NewVmCommand" IsEnabled="{Binding IsEnabled, ElementName=Library}" Click="NewVm" Style="{StaticResource CommandButton}" ToolTip="{local:Loc &apos;新しい仮想マシン (Ctrl+N)&apos;}" AutomationProperties.Name="{local:Loc &apos;新しい仮想マシン&apos;}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,7,0"/><TextBlock Text="{local:Loc &apos;新規&apos;}" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button IsEnabled="{Binding IsEnabled, ElementName=Library}" Click="OpenVm" Style="{StaticResource CommandButton}" ToolTip="{local:Loc &apos;仮想マシンを開く (Ctrl+O)&apos;}" AutomationProperties.Name="{local:Loc &apos;仮想マシンを開く&apos;}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,7,0"/><TextBlock Text="{local:Loc &apos;開く&apos;}" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Border Width="1" Background="{DynamicResource CardBorderBrush}" Margin="10,6"/>
              <Button x:Name="StartButton" Content="{local:Loc &apos;▶  起動&apos;}" Tag="Start" Click="ActionClick" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="2,0,6,0" MinHeight="34"/>
              <Button x:Name="ResumeButton" Content="{local:Loc &apos;▶  再開&apos;}" Tag="Resume" Click="ActionClick" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="2,0,6,0" MinHeight="34" Visibility="Collapsed"/>
              <Button x:Name="PowerOffButton" Tag="PowerOff" Click="ActionClick" Style="{StaticResource CommandButton}" AutomationProperties.Name="{local:Loc &apos;シャットダウン&apos;}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,8,0"/>
                  <TextBlock Text="{local:Loc &apos;シャットダウン&apos;}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="RestartButton" Tag="Restart" Click="ActionClick" Style="{StaticResource CommandButton}" ToolTip="{local:Loc &apos;macOS を再起動&apos;}" AutomationProperties.Name="{local:Loc &apos;再起動&apos;}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,8,0"/>
                  <TextBlock Text="{local:Loc &apos;再起動&apos;}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="PowerMoreButton" Content="" FontFamily="Segoe Fluent Icons" FontSize="16" Style="{StaticResource CommandButton}" ToolTip="{local:Loc &apos;一時停止・完全終了など&apos;}" AutomationProperties.Name="{local:Loc &apos;その他の電源操作&apos;}" Click="ShowPowerMenu">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{local:Loc &apos;完全終了（設定変更前）&apos;}" Tag="Exit" Click="MenuAction"/>
                    <MenuItem Header="{local:Loc &apos;一時停止&apos;}" Tag="Pause" Click="MenuAction"/>
                    <MenuItem Header="{local:Loc &apos;再開&apos;}" Tag="Resume" Click="MenuAction"/>
                    <Separator/>
                    <MenuItem Header="{local:Loc &apos;強制終了…&apos;}" Tag="ForceExit" Click="ForceExit"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Border Width="1" Background="{DynamicResource CardBorderBrush}" Margin="10,6"/>
              <Button x:Name="ConsoleCommand" Click="DockConsole" Style="{StaticResource CommandButton}" IsEnabled="{Binding IsEnabled, ElementName=ConsoleConnectButton}" ToolTip="{local:Loc &apos;コンソールに切り替えて接続&apos;}" AutomationProperties.Name="{local:Loc &apos;コンソールに接続&apos;}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,8,0"/>
                  <TextBlock Text="{local:Loc &apos;コンソール&apos;}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="2" Click="RefreshClick" Style="{StaticResource CommandButton}" ToolTip="{local:Loc &apos;状態を更新 (F5)&apos;}" AutomationProperties.Name="{local:Loc &apos;状態を更新&apos;}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,8,0"/>
                <TextBlock Text="{local:Loc &apos;更新&apos;}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </StackPanel>
      <Grid Grid.Row="3" x:Name="WorkstationLayout">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="LibraryColumn" Width="236" MinWidth="200" MaxWidth="340"/>
          <ColumnDefinition Width="5"/>
          <ColumnDefinition Width="*" MinWidth="630"/>
        </Grid.ColumnDefinitions>
        <Border Padding="12,16,10,12" x:Name="LibraryPane">
          <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="SidebarLayout" Height="{Binding ViewportHeight, ElementName=SidebarScroll}" MinHeight="460">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="80"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="8,0,0,18">
                <TextBlock Text="" Style="{StaticResource CommandIcon}" FontSize="24" Margin="0,0,10,0"/>
                <TextBlock Text="Reims" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
              <Grid Grid.Row="1" Margin="8,0,4,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{local:Loc &apos;ライブラリ&apos;}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Items.Count, ElementName=Library}" Style="{StaticResource MutedText}" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc &apos;表示中の VM 数&apos;}"/>
              </Grid>
              <StackPanel Grid.Row="2">
                <Grid Margin="0,0,0,16">
                  <TextBox x:Name="LibrarySearch" TextChanged="FilterLibrary" Padding="32,7,10,7" ToolTip="{local:Loc &apos;VM の名前で絞り込み&apos;}" AutomationProperties.Name="{local:Loc &apos;仮想マシンを検索&apos;}"/>
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  <TextBlock Text="{local:Loc &apos;VM を検索&apos;}" IsHitTestVisible="False" Margin="33,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,8">
                  <TextBlock Text="" Style="{StaticResource CommandIcon}" FontSize="16" Margin="0,0,8,0"/>
                  <TextBlock Text="{local:Loc &apos;このコンピューター&apos;}" Style="{StaticResource MutedText}" FontSize="12"/>
                </StackPanel>
              </StackPanel>
              <Grid Grid.Row="3" Margin="0,0,0,12">
                <ListBox x:Name="Library" BorderThickness="0" Background="Transparent" SelectionChanged="VmChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:Loc &apos;仮想マシン一覧&apos;}" MouseDoubleClick="OpenLibraryConsole">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItem}">
                      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                      <Setter Property="AutomationProperties.HelpText" Value="{Binding Directory}"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,3" ToolTip="{Binding File}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="34"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="" Style="{StaticResource CommandIcon}" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                          <TextBlock x:Name="VmPathLabel" Text="{Binding Subtitle}" ToolTip="{Binding Directory}" FontSize="11" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
