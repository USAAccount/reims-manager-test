                  <StackPanel x:Name="CpuPage" Visibility="Collapsed">
                    <TextBlock Text="{local:Loc &apos;プロセッサ&apos;}" Style="{StaticResource PageHeading}"/>
                    <TextBlock Text="{local:Loc &apos;Windows のハードウェア仮想化を使用します。&apos;}" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{local:Loc &apos;CPU コア数&apos;}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="Cpus" Text="8" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="{local:Loc &apos;CPU コア数&apos;}"/>
                    <TextBlock Text="{local:Loc &apos;1 ソケット / Windows Hypervisor Platform&apos;}" Style="{StaticResource MutedText}" Margin="0,24,0,0"/>
                  </StackPanel>
                  <StackPanel x:Name="DiskPage" Visibility="Collapsed">
                    <TextBlock Text="{local:Loc &apos;ハードディスク&apos;}" Style="{StaticResource PageHeading}"/>
                    <TextBlock x:Name="DiskInfo" TextWrapping="Wrap" Margin="0,8,0,16"/>
                    <WrapPanel>
                      <Button Content="{local:Loc &apos;保存先を開く&apos;}" Click="RevealVm"/>
                      <Button Content="{local:Loc &apos;ディスク差分を整理&apos;}" Tag="OptimizeDisk" Click="ActionClick"/>
                    </WrapPanel>
                    <TextBlock Text="{local:Loc &apos;拡張後の容量 (GiB)&apos;}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DiskSize" Text="128" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="{local:Loc &apos;拡張後のディスク容量 GiB&apos;}"/>
                    <Button Content="{local:Loc &apos;容量を拡張…&apos;}" Click="ExpandDisk" HorizontalAlignment="Left" Margin="0,16,0,8" Tag="ExpandDisk"/>
                    <TextBlock Text="{local:Loc &apos;拡張後、macOS の Disk Utility でも APFS 領域を拡張します。&apos;}" Style="{StaticResource MutedText}"/>
                  </StackPanel>
                  <StackPanel x:Name="MediaPage" Visibility="Collapsed">
                    <TextBlock Text="{local:Loc &apos;CD/DVD・ISO&apos;}" Style="{StaticResource PageHeading}"/>
                    <CheckBox x:Name="HardwareIso" Content="{local:Loc &apos;起動時にインストーラーを接続&apos;}" Margin="0,18,0,16"/>
                    <TextBox x:Name="HardwareIsoPath" MinWidth="120" VerticalContentAlignment="Center" AutomationProperties.Name="{local:Loc &apos;起動時に接続する ISO の保存先&apos;}"/>
                    <Button x:Name="HardwareIsoBrowseButton" Content="{local:Loc &apos;ISO を選択…&apos;}" Click="BrowseHardwareIso" HorizontalAlignment="Left" Margin="0,16,0,8"/>
                    <TextBlock Text="{local:Loc &apos;インストールが終わったら接続を解除できます。&apos;}" Style="{StaticResource MutedText}"/>
                  </StackPanel>
                  <StackPanel x:Name="NetworkPage" Visibility="Collapsed">
                    <TextBlock Text="{local:Loc &apos;ネットワーク&apos;}" Style="{StaticResource PageHeading}"/>
                    <RadioButton x:Name="Nat" Content="{local:Loc &apos;NAT（通常はこちら）&apos;}" IsChecked="True" Margin="0,18,0,6"/>
                    <TextBlock Text="{local:Loc &apos;Windows のインターネット接続を共有します。Apple Account も使用できます。&apos;}" Style="{StaticResource MutedText}" Margin="24,0,0,20"/>
                    <RadioButton x:Name="Bridge" Content="{local:Loc &apos;LAN に直接接続&apos;}" Margin="0,0,0,6"/>
                    <TextBlock Text="{local:Loc &apos;Wi-Fi は IPv4 / IPv6 の互換接続、有線 LAN は Windows ブリッジを使用します。&apos;}" Style="{StaticResource MutedText}" Margin="24,0,0,8"/>
                    <TextBlock Text="{local:Loc &apos;ホストの接続先&apos;}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="Uplink" DisplayMemberPath="DisplayName" SelectedValuePath="Id" ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="{local:Loc &apos;物理 Wi-Fi・有線 LAN の接続先&apos;}"/>
                    <TextBlock x:Name="NetworkNotice" Style="{StaticResource MutedText}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <Expander x:Name="NetworkTapDetails" Header="{local:Loc &apos;詳細: 内部 TAP アダプター&apos;}" Margin="0,16,0,0">
                      <StackPanel><TextBlock Text="{local:Loc &apos;ブリッジを準備した専用 TAP を選びます。物理アダプターを直接 VM に転送する設定ではありません。&apos;}" Style="{StaticResource MutedText}" Margin="0,8,0,8"/>
                        <ComboBox x:Name="Tap" AutomationProperties.Name="{local:Loc &apos;内部 TAP アダプター&apos;}"/>
                      </StackPanel>
                    </Expander>
                    <TextBlock Text="{local:Loc &apos;macOS の IP アドレス / ホスト名&apos;}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="GuestHost" AutomationProperties.Name="{local:Loc &apos;macOS の IP アドレスまたはホスト名&apos;}"/>
                    <Button Content="{local:Loc &apos;LAN 接続の準備&apos;}" Click="OpenBridgeTab" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                  </StackPanel>
                  <StackPanel x:Name="UsbPage" Visibility="Collapsed" IsVisibleChanged="UsbPageVisibilityChanged">
                    <TextBlock Text="{local:Loc &apos;USB デバイス&apos;}" Style="{StaticResource PageHeading}"/>
                    <TextBlock Text="{local:Loc &apos;Windows に接続したデバイスを、この VM に接続します。接続中は Windows 側から使用できません。&apos;}" Style="{StaticResource MutedText}"/>
                    <WrapPanel Margin="0,18,0,12">
                      <Button x:Name="UsbRefreshButton" Content="{local:Loc &apos;デバイス一覧を更新&apos;}" Click="RefreshUsb" Tag="ListUsb"/>
                      <Button x:Name="InstallUsbDkButton" Content="{local:Loc &apos;UsbDk を導入…&apos;}" Click="InstallUsbDk" Tag="InstallUsbDk"/>
                    </WrapPanel>
                    <ListBox x:Name="UsbDevices" MinHeight="140" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{local:Loc &apos;USB デバイスの登録と接続状態&apos;}">
                      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="UsbSelectionHint" Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="{local:Loc &apos;一覧を更新してから操作してください。&apos;}"/>
                    <WrapPanel Margin="0,12,0,0">
                      <Button x:Name="UsbAttachButton" Content="{local:Loc &apos;接続して自動接続に登録&apos;}" Click="AttachUsb" Tag="AttachUsb"/>
                      <Button x:Name="UsbDetachButton" Content="{local:Loc &apos;登録を解除して Windows に戻す&apos;}" Click="DetachUsb" Tag="DetachUsb"/>
                    </WrapPanel>
                    <TextBlock Text="{local:Loc &apos;転送方式（変更は次回起動時）&apos;}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="UsbBackend" SelectedIndex="0" AutomationProperties.Name="{local:Loc &apos;USB 転送方式&apos;}">
                      <ComboBoxItem>WinUSB（iPhone は一時切替、その他は対応ドライバーが必要）</ComboBoxItem>
                      <ComboBoxItem>UsbDk（汎用転送・ドライバー導入後）</ComboBoxItem>
                    </ComboBox>
                    <TextBlock x:Name="UsbBackendHint" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
                    <TextBlock x:Name="UsbHint" Style="{StaticResource MutedText}" Text="{local:Loc &apos;「デバイス一覧を更新」で、この VM の USB 登録と接続状態を確認します。&apos;}"/>
                  </StackPanel>
                  <StackPanel x:Name="AudioPage" Visibility="Collapsed">
                    <TextBlock Text="{local:Loc &apos;マイク・スピーカー&apos;}" Style="{StaticResource PageHeading}"/>
                    <TextBlock Text="{local:Loc &apos;Windows の標準デバイスを macOS と共有します。&apos;}" Style="{StaticResource MutedText}"/>
                    <CheckBox x:Name="Sound" Content="{local:Loc &apos;スピーカーを共有&apos;}" Margin="0,24,0,16"/>
                    <CheckBox x:Name="Microphone" Content="{local:Loc &apos;マイクを共有&apos;}" Margin="0,0,0,20"/>
                    <TextBlock Text="{local:Loc &apos;マイクは macOS のアプリが録音を開始したときに使用します。Windows と macOS の両方でマイクの使用許可を確認してください。&apos;}" Style="{StaticResource MutedText}"/>
                    <Button Content="{local:Loc &apos;Windows のサウンド設定&apos;}" Click="OpenSoundSettings" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                  </StackPanel>
                  <StackPanel x:Name="DisplayPage" Visibility="Collapsed">
                    <TextBlock Text="{local:Loc &apos;ディスプレイ&apos;}" Style="{StaticResource PageHeading}"/>
                    <TextBlock Text="{local:Loc &apos;起動時の解像度&apos;}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="Resolution" AutomationProperties.Name="{local:Loc &apos;起動時の解像度&apos;}">
                      <ComboBoxItem>1280x720</ComboBoxItem>
                      <ComboBoxItem IsSelected="True">1920x1080</ComboBoxItem>
                      <ComboBoxItem>2560x1440</ComboBoxItem>
                      <ComboBoxItem>3840x2160</ComboBoxItem>
                    </ComboBox>
                    <Button Content="{local:Loc &apos;実行中の macOS に適用&apos;}" Click="ApplyResolution" HorizontalAlignment="Left" Margin="0,18,0,0" Tag="ApplyResolution"/>
                    <TextBlock Text="{local:Loc &apos;適用に成功すると、次回の VM 起動時にもこの解像度を使用します。VM が停止中の場合は、下の「変更を保存」で起動時の解像度を保存できます。&apos;}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                    <TextBlock Text="{local:Loc &apos;macOS 26 の Intel VM では、画面幅が 2048 ピクセルを超えると表示が乱れる既知の問題があります。安定した操作には 1920 × 1080 を推奨します。4K は描画負荷も高くなります。&apos;}" Style="{StaticResource MutedText}" Margin="0,20,0,0"/>
                    <Border x:Name="CursorAidCard" Style="{StaticResource NoticeCard}" Margin="0,20,0,0"><StackPanel>
                      <TextBlock Text="{local:Loc &apos;カーソル互換表示&apos;}" FontSize="18" FontWeight="SemiBold"/>
                      <TextBlock Text="{local:Loc &apos;画面ミラーリングでカーソルが見えないときに、macOS の実際のカーソルを通常の画面内容として描画します。&apos;}" Style="{StaticResource MutedText}" Margin="0,8,0,8"/>
                      <TextBlock Text="{local:Loc &apos;この VM の macOS ユーザーで、ログイン後もオンの状態が続きます。ミラーリングは自動検出しません。必要なときだけオンにし、不要になったらオフにしてください。操作には実行中の VM と SSH ペアリングが必要です。&apos;}" Style="{StaticResource MutedText}"/>
                      <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="EnableCursorAidButton" Content="{local:Loc &apos;オンにする&apos;}" Tag="EnableCursorAid" Click="ActionClick" AutomationProperties.Name="{local:Loc &apos;カーソル互換表示をオンにする&apos;}"/>
                        <Button x:Name="DisableCursorAidButton" Content="{local:Loc &apos;オフにする&apos;}" Tag="DisableCursorAid" Click="ActionClick" AutomationProperties.Name="{local:Loc &apos;カーソル互換表示をオフにする&apos;}"/>
                      </WrapPanel>
                      <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="MoveCursorMainButton" Content="{local:Loc &apos;VM 本体の画面へ移動&apos;}" Tag="MoveCursorToMainDisplay" Click="ActionClick"/>
                        <Button x:Name="MoveCursorExtendedButton" Content="{local:Loc &apos;拡張画面へ移動&apos;}" Tag="MoveCursorToExtendedDisplay" Click="ActionClick"/>
                      </WrapPanel>
                      <TextBlock Text="{local:Loc &apos;移動先の画面配置と倍率を読み取り、実際の画面中央へ移動します。拡張画面を複数検出した場合は自動選択しません。&apos;}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                      <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="HideHostCursorButton" Content="{local:Loc &apos;Windows 側を隠す&apos;}" Tag="HideHostCursor" Click="ActionClick"/>
                        <Button x:Name="ShowHostCursorButton" Content="{local:Loc &apos;Windows 側を表示&apos;}" Tag="ShowHostCursor" Click="ActionClick"/>
                      </WrapPanel>
                      <TextBlock Text="{local:Loc &apos;対応エンジンで、VM の画面内だけ Windows 側のカーソルを隠します。VM 内にカーソルを表示するには、上の「カーソル互換表示」などゲスト側で描画するカーソルが必要です。入力を Windows に戻す: Ctrl + Alt + Home / Ctrl + Alt + Win。&apos;}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                    <Border x:Name="ExtendedDisplayCard" Style="{StaticResource NoticeCard}" Margin="0,16,0,0"><StackPanel>
                      <TextBlock Text="{local:Loc &apos;拡張画面の軽量化&apos;}" FontSize="18" FontWeight="SemiBold"/>
                      <TextBlock Text="{local:Loc &apos;拡張画面の広さを保ったまま、描画ピクセル数が少ないモードに切り替えます。文字の精細さは下がります。VM 本体の画面は変更しません。&apos;}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                      <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="LightenExtendedDisplayButton" Content="{local:Loc &apos;拡張画面を軽くする&apos;}" Tag="LightenExtendedDisplay" Click="ActionClick"/>
                        <Button x:Name="RestoreExtendedDisplayButton" Content="{local:Loc &apos;元の画質へ戻す&apos;}" Tag="RestoreExtendedDisplay" Click="ActionClick"/>
                      </WrapPanel>
                      <TextBlock Text="{local:Loc &apos;現在のログイン中だけ適用します。再接続後は必要に応じて再適用してください。変更後に別の設定が適用された場合は、保存した設定で上書きしません。&apos;}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                    <TextBlock Text="Reims vGPU · Apple Paravirtualized Graphics" Style="{StaticResource MutedText}" Margin="0,24,0,0"/>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Loc &apos;共有&apos;}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,28" MaxWidth="680" HorizontalAlignment="Left">
                  <TextBlock Text="{local:Loc &apos;クリップボード&apos;}" Style="{StaticResource PageHeading}"/>
                  <TextBlock Text="{local:Loc &apos;Windows と macOS の間でテキストをコピー＆ペーストできます。&apos;}" Style="{StaticResource MutedText}"/>
                  <CheckBox x:Name="ClipboardSharing" Content="{local:Loc &apos;テキストを自動で共有する&apos;}" Checked="ClipboardChanged" Unchecked="ClipboardChanged" Margin="0,24,0,12"/>
                  <TextBlock Text="{local:Loc &apos;共有する設定は VM ごとに保存され、次回この VM を開いたときも引き継ぎます。アプリの起動中、VM が実行中のときにテキストを共有します。画像・ファイルは対象外です。&apos;}" Style="{StaticResource MutedText}"/>
                  <WrapPanel Margin="0,24,0,0">
                    <Button Content="Windows → macOS" Click="CopyToGuest" Tag="Clipboard"/>
                    <Button Content="macOS → Windows" Click="CopyFromGuest" Tag="Clipboard"/>
                  </WrapPanel>
                  <TextBlock x:Name="ClipboardStatus" Text="{local:Loc &apos;自動共有はオフです。&apos;}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
                  <TextBlock Text="{local:Loc &apos;接続について&apos;}" Style="{StaticResource SectionHeading}"/>
                  <TextBlock Text="{local:Loc &apos;共有には SSH のペアリングが必要です。コピー内容をファイルやログには保存しません。&apos;}" Style="{StaticResource MutedText}"/>
                  <Button Content="{local:Loc &apos;SSH ペアリングを設定&apos;}" Tag="6" Click="NavigatePage" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="OpenCore">
              <ScrollViewer x:Name="OpenCoreScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,28" MaxWidth="680" HorizontalAlignment="Stretch">
                  <TextBlock Text="{local:Loc &apos;Mac の識別情報&apos;}" Style="{StaticResource PageHeading}"/>
                  <TextBlock Text="{local:Loc &apos;Apple Account にログイン済みの場合、識別情報を変更すると再認証が必要になることがあります。&apos;}" Style="{StaticResource MutedText}"/>
                  <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="20"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                      <TextBlock Text="{local:Loc &apos;モデル&apos;}"/>
                      <TextBox x:Name="IdentityModel" Margin="0,6,0,14" AutomationProperties.Name="{local:Loc &apos;Mac のモデル&apos;}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{local:Loc &apos;シリアル番号&apos;}"/>
                      <TextBox x:Name="IdentitySerial" Margin="0,6,0,14" AutomationProperties.Name="{local:Loc &apos;Mac のシリアル番号&apos;}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                      <TextBlock Text="{local:Loc &apos;MLB（ボードシリアル）&apos;}"/>
                      <TextBox x:Name="IdentityMlb" Margin="0,6,0,14" AutomationProperties.Name="{local:Loc &apos;MLB ボードシリアル&apos;}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                      <TextBlock Text="{local:Loc &apos;ROM（12 桁の16進数）&apos;}"/>
                      <TextBox x:Name="IdentityRom" Margin="0,6,0,14" AutomationProperties.Name="{local:Loc &apos;ROM 12 桁の16進数&apos;}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                      <TextBlock Text="System UUID"/>
                      <TextBox x:Name="IdentityUuid" Margin="0,6,0,0" AutomationProperties.Name="System UUID"/>
                    </StackPanel>
                  </Grid>
                  <WrapPanel Margin="0,20,0,0">
                    <Button Content="{local:Loc &apos;識別情報を保存&apos;}" Click="SaveIdentity" Style="{StaticResource PrimaryButton}" Tag="SetIdentity"/>
                    <Button Content="{local:Loc &apos;現在の設定を読み込む&apos;}" Click="LoadIdentityClick" Tag="GetIdentity"/>
                    <Button Content="{local:Loc &apos;新しく生成…&apos;}" Click="GenerateIdentity" Tag="GenerateIdentity"/>
                  </WrapPanel>
                  <TextBlock Text="{local:Loc &apos;OpenCore の起動設定（macOS 26.x）&apos;}" Style="{StaticResource SectionHeading}"/>
                  <TextBlock Text="{local:Loc &apos;APFS / HFS の起動ディスクを検索する設定を再適用します。SMBIOS・保存済みの識別情報は保持します。VM の完全終了後に操作してください。&apos;}" Style="{StaticResource MutedText}"/>
                  <Button x:Name="ApplyBootProfileButton" Content="{local:Loc &apos;起動プロファイルを再適用&apos;}" Tag="ApplyBootProfile" Click="ActionClick" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                  <TextBlock Text="{local:Loc &apos;GPU 互換ブリッジ&apos;}" Style="{StaticResource SectionHeading}"/>
                  <TextBlock Text="{local:Loc &apos;macOS 26.x の共通 ABI に対応する GPU 互換ブリッジを適用・解除します。未対応の ABI や不明なレイアウトは安全に拒否します。&apos;}" Style="{StaticResource MutedText}"/>
                  <TextBlock x:Name="GuestBridgeStatus" Text="{local:Loc &apos;適用状況は未確認です。&apos;}" Style="{StaticResource MutedText}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                  <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="EnableGuestBridgeButton" Content="{local:Loc &apos;GPU 互換ブリッジを適用&apos;}" Tag="EnableGuestBridge" Click="ActionClick"/>
                    <Button x:Name="DisableGuestBridgeButton" Content="{local:Loc &apos;GPU 互換ブリッジを解除&apos;}" Tag="DisableGuestBridge" Click="ActionClick"/>
                  </WrapPanel>
                  <TextBlock Text="{local:Loc &apos;休止状態は使用しないでください。GPU 互換ブリッジは共通 ABI を実行時に検証し、不明なレイアウトは拒否します。&apos;}" Style="{StaticResource MutedText}"/>
                  <Button Content="{local:Loc &apos;macOS の更新検出を修復&apos;}" Tag="PrepareUpdates" Click="ActionClick" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Loc &apos;スナップショット&apos;}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,28" MaxWidth="680" HorizontalAlignment="Stretch">
                  <TextBlock Text="{local:Loc &apos;状態を保存・復元&apos;}" Style="{StaticResource PageHeading}"/>
                  <TextBlock Text="{local:Loc &apos;VM を完全終了してから保存します。復元しても現在のディスクは保持されます。&apos;}" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="{local:Loc &apos;保存する名前&apos;}" Style="{StaticResource FieldLabel}"/>
                  <DockPanel>
                    <Button Content="{local:Loc &apos;保存&apos;}" DockPanel.Dock="Right" Click="SaveSnapshot" Style="{StaticResource PrimaryButton}" Tag="SnapshotCreate"/>
                    <TextBox x:Name="SnapshotName" AutomationProperties.Name="{local:Loc &apos;保存するスナップショットの名前&apos;}"/>
                  </DockPanel>
                  <TextBlock Text="{local:Loc &apos;保存済みの状態&apos;}" Style="{StaticResource FieldLabel}"/>
                  <DockPanel>
                    <Button Content="{local:Loc &apos;復元…&apos;}" DockPanel.Dock="Right" Click="RestoreSnapshot" Tag="SnapshotRestore"/>
                    <ComboBox x:Name="Snapshots" AutomationProperties.Name="{local:Loc &apos;復元するスナップショット&apos;}"/>
                  </DockPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Loc &apos;セットアップ&apos;}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,28" MaxWidth="680" HorizontalAlignment="Stretch">
                  <TextBlock Text="{local:Loc &apos;macOS をインストール&apos;}" Style="{StaticResource PageHeading}"/>
                  <TextBlock Text="{local:Loc &apos;1  インストーラーを選択&apos;}" Style="{StaticResource SectionHeading}"/>
                  <DockPanel>
                    <Button Content="{local:Loc &apos;ISO を選択…&apos;}" DockPanel.Dock="Right" Click="BrowseIso"/>
                    <TextBox x:Name="Iso" MinWidth="120" VerticalContentAlignment="Center" AutomationProperties.Name="{local:Loc &apos;macOS インストーラーの保存先&apos;}"/>
                  </DockPanel>
                  <TextBlock Text="{local:Loc &apos;2  ディスクを準備&apos;}" Style="{StaticResource SectionHeading}"/>
                  <TextBlock Text="{local:Loc &apos;新規ディスクの容量 (GiB)&apos;}" Margin="0,0,0,8"/>
                  <TextBox x:Name="NewDiskSize" Text="300" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="{local:Loc &apos;新規ディスクの容量 GiB&apos;}"/>
                  <TextBlock Text="{local:Loc &apos;3  作成後の動作&apos;}" Style="{StaticResource SectionHeading}"/>
                  <CheckBox x:Name="StartAfterSetup" IsChecked="True" Content="{local:Loc &apos;作成後、インストーラーを起動する&apos;}" Margin="0,0,0,12"/>
                  <CheckBox x:Name="ConnectIso" Content="{local:Loc &apos;インストーラーを接続して起動（一時指定・保存しません）&apos;}" Margin="0,0,0,8"/>
                  <TextBlock Text="{local:Loc &apos;次回以降もインストーラーを接続する場合は、「CD/DVD・ISO」で起動時の設定を保存してください。&apos;}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                  <TextBlock Text="{local:Loc &apos;Disk Utility で仮想ディスクを APFS に初期化し、macOS をインストールします。初回設定後、REIMSTOOLS の setup.command を実行してください。&apos;}" Style="{StaticResource MutedText}"/>
                  <Button Content="{local:Loc &apos;仮想マシンを作成&apos;}" Click="Setup" HorizontalAlignment="Left" Margin="0,24,0,8" Style="{StaticResource PrimaryButton}" Tag="Setup"/>
                  <Expander Header="{local:Loc &apos;エンジンの準備&apos;}" Margin="0,24,0,0">
                    <WrapPanel Margin="0,12,0,0">
                      <Button Content="{local:Loc &apos;WHPX を有効化…&apos;}" Click="EnableWhpx"/>
                    </WrapPanel>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Loc &apos;接続&apos;}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,28" MaxWidth="680" HorizontalAlignment="Stretch">
                  <TextBlock Text="{local:Loc &apos;macOS とペアリング&apos;}" Style="{StaticResource PageHeading}"/>
                  <TextBlock Text="{local:Loc &apos;Finder の REIMSTOOLS から setup.command を開き、表示されたユーザー名と指紋を入力します。&apos;}" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="{local:Loc &apos;macOS ユーザー名&apos;}" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="GuestUser" AutomationProperties.Name="{local:Loc &apos;SSH 接続する macOS ユーザー名&apos;}"/>
                  <TextBlock Text="{local:Loc &apos;SHA256 指紋&apos;}" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="Fingerprint" AutomationProperties.Name="{local:Loc &apos;SSH ホスト鍵の SHA256 指紋&apos;}"/>
                  <Button Content="{local:Loc &apos;指紋を照合して接続&apos;}" Click="Pair" HorizontalAlignment="Left" Margin="0,20,0,16" Style="{StaticResource PrimaryButton}" Tag="Pair"/>
                  <TextBlock Text="{local:Loc &apos;macOS のパスワードは保存しません。SSH 鍵はこの VM のフォルダーに保持します。&apos;}" Style="{StaticResource MutedText}"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="{local:Loc &apos;ブリッジ&apos;}">
              <ScrollViewer x:Name="BridgeScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,28" MaxWidth="680" HorizontalAlignment="Stretch">
                  <TextBlock Text="{local:Loc &apos;LAN 接続を準備&apos;}" Style="{StaticResource PageHeading}"/>
                  <TextBlock Text="{local:Loc &apos;接続する Wi-Fi・有線 LAN を選びます。通常のインターネット利用には NAT を使用できます。選択だけでは Windows の接続を変更しません。&apos;}" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="{local:Loc &apos;ホストの接続先&apos;}" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="Physical" DisplayMemberPath="DisplayName" SelectedValuePath="Id" ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}" SelectionChanged="WifiSelectionChanged" AutomationProperties.Name="{local:Loc &apos;LAN に接続する物理 Wi-Fi・有線 LAN&apos;}"/>
                  <Button Content="{local:Loc &apos;接続先を更新&apos;}" Click="ReloadNetworkChoices" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                  <Border x:Name="WifiCompatCard" Style="{StaticResource NoticeCard}" Margin="0,16,0,0" Visibility="Collapsed"><StackPanel>
                    <TextBlock Text="{local:Loc &apos;Wi-Fi 互換接続（IPv4 / IPv6）&apos;}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{local:Loc &apos;専用 TAP を自動で準備します。IPv6 の実際の利用可否はルーター・回線の対応状況にも依存します。&apos;}" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
                    <TextBlock x:Name="WifiForwarderSummary" Text="{local:Loc &apos;転送状態は未確認です&apos;}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="WifiForwarderDetail" Style="{StaticResource MutedText}" Margin="0,6,0,12"/></ScrollViewer>
                    <TextBlock Text="{local:Loc &apos;外部ドライバーは非商用の個人・学術用途、商用評価向けです。商用運用・再配布には配布元の別ライセンスが必要です。導入時は Windows 全体の通信が一時的に切れる場合があります。&apos;}" Style="{StaticResource MutedText}"/>
                    <TextBlock Margin="0,8,0,8"><Hyperlink NavigateUri="https://www.ntkernel.com/windows-packet-filter/download/" RequestNavigate="OpenPacketFilterTerms"><Run Text="{local:Loc &apos;配布元の利用条件&apos;}"/></Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.ntkernel.com/windows-packet-filter/licensing/" RequestNavigate="OpenPacketFilterTerms"><Run Text="{local:Loc &apos;商用ライセンス&apos;}"/></Hyperlink></TextBlock>
                    <CheckBox x:Name="PacketFilterTerms" Click="WifiTermsChanged" Margin="0,0,0,12"><TextBlock Text="{local:Loc &apos;配布元の個人利用・評価用の利用条件を確認し、同意します（未導入時に必要）。&apos;}" TextWrapping="Wrap"/></CheckBox>
                    <WrapPanel><Button x:Name="PrepareWifiButton" Content="{local:Loc &apos;Wi-Fi 互換接続を準備&apos;}" Click="PrepareWifi" Tag="PrepareWifi"/><Button x:Name="DisableWifiButton" Content="{local:Loc &apos;解除して NAT に戻す&apos;}" Click="DisableWifi" Tag="DisableWifi"/></WrapPanel>
                  </StackPanel></Border>
                  <StackPanel x:Name="WiredBridgeControls">
                  <TextBlock Text="{local:Loc &apos;有線 LAN は Windows ブリッジで接続します。作成時に Windows の通信が一時的に切れる場合があります。&apos;}" Style="{StaticResource MutedText}"/>
                  <Button x:Name="InstallTapButton" Content="{local:Loc &apos;専用 TAP ドライバーを自動導入…&apos;}" Click="InstallTap" Tag="InstallTap" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                  <TextBlock Text="{local:Loc &apos;署名を確認した公式ドライバーを取得します。ブリッジの作成は別の操作です。&apos;}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                  <Expander Header="{local:Loc &apos;詳細: 既存の専用 TAP を選択&apos;}" Margin="0,16,0,0"><StackPanel>
                  <TextBlock Text="{local:Loc &apos;TAP アダプター&apos;}" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="BridgeTap"/>
                  <TextBlock Text="{local:Loc &apos;他の VPN の TAP を選ばず、Reims 専用のものを明示して選択してください。&apos;}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                  </StackPanel></Expander>
                  <Button Content="{local:Loc &apos;ブリッジを作成…&apos;}" Click="CreateBridge" Tag="CreateBridge" HorizontalAlignment="Left" Margin="0,20,0,12"/>
                  <Button x:Name="RemoveBridgeButton" Content="{local:Loc &apos;ブリッジを解除して NAT に戻す…&apos;}" Click="RemoveBridge" Tag="RemoveBridge" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                  <TextBlock Text="{local:Loc &apos;Windows の管理者権限が必要です。作成時はネットワーク接続が一時的に切れる場合があります。&apos;}" Style="{StaticResource MutedText}"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
          </Grid>
        </Border>
        <Border x:Name="SettingsFooter" Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock x:Name="SettingsHint" Text="{local:Loc &apos;変更はありません。&apos;}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock x:Name="SettingsScopeHint" Text="{local:Loc &apos;ハードウェア設定は「変更を保存」で確定し、次回の VM 起動から使用します。&apos;}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="ReloadHardwareButton" Content="{local:Loc &apos;変更を破棄…&apos;}" Click="DiscardSettingsEdits" MinWidth="100" Margin="0,0,8,0" ToolTip="{local:Loc &apos;未保存のハードウェア・識別情報を元に戻します。実行済みの操作は保持します。&apos;}"/>
              <Button x:Name="SaveHardwareButton" Content="{local:Loc &apos;変更を保存&apos;}" Click="ApplySettings" MinWidth="100" Margin="0,0,8,0" ToolTip="Ctrl+S"/>
              <Button x:Name="SettingsOkButton" Content="{local:Loc &apos;閉じる&apos;}" Click="SaveAndCloseSettings" Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
